{
  "manifest_version": 3,
  "name": "CouponTest",
  "version": "0.4.0",
  "description": "Test pasted coupon codes with robust input events, apply-button clicking, and response capture.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "CouponTest",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-v4.js"],
      "run_at": "document_idle"
    }
  ]
}