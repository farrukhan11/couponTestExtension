{
  "manifest_version": 3,
  "name": "CouponTest",
  "version": "0.6.2",
  "description": "Test pasted coupon codes with Shopify discount-chip detection and safe UI-only reset.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "CouponTest",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-v6.js"],
      "run_at": "document_idle"
    }
  ]
}
