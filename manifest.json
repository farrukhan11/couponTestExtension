{
  "manifest_version": 3,
  "name": "CouponTest",
  "version": "0.7.2",
  "description": "Test pasted coupon codes with robust discount-chip handling, reset-required reporting, stale-response protection, and non-blocking removal.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "CouponTest",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-v7.js"],
      "run_at": "document_idle"
    }
  ]
}
